# Copiá a la raíz del repo como .env (junto a docker-compose.yml)
# docker compose lee este archivo para el servicio "api"

# --- Base de datos (PostgreSQL en el VPS, fuera de Docker) ---
# Si Postgres escucha en localhost del host, usá host.docker.internal
DATABASE_URL=postgresql+psycopg://USUARIO:PASSWORD@host.docker.internal:5432/postgres

# Si Postgres solo acepta conexión por IP pública del VPS:
# DATABASE_URL=postgresql+psycopg://USUARIO:PASSWORD@45.236.130.10:5432/postgres

SECRET_KEY=genera-un-secreto-largo-y-aleatorio
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# URL pública del sitio (con https si usás TLS)
CORS_ORIGINS=http://45.236.130.10

DEFAULT_INSTITUTION_ID=00000000-0000-0000-0000-000000000001

# Puerto donde se publica el frontend (80 = http estándar)
HTTP_PORT=80
